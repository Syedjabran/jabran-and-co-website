# ============================================================================
# Jabran & Co — configuration reference.  NAMES ONLY, never real values.
#
# The website itself needs NO env file: it uses the Supabase URL and the
# publishable (public, RLS-protected) key in supabase-client.js.
#
# Everything below is a SUPABASE EDGE FUNCTION SECRET. Set them in
#   Supabase Dashboard → Edge Functions → Secrets
# or:  npx supabase secrets set NAME=value --project-ref dvsaqjvcxqlzgpbvexnu
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by Supabase automatically — never set or copy them by hand.
# Full table of which function reads what: docs/ARCHITECTURE.md §6.
# ============================================================================

# Shared
SITE_URL=https://www.jabranandco.com

# notify-enquiry (Resend + database webhook)
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=
WEBHOOK_SECRET=

# send-client-email (Google Apps Script Gmail relay)
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=
REPLY_TO=
SENDER_NAME=

# AI agents (ai-agent, ai-client-agent, ai-accountant, advisory-agent, analytics-agent)
# — see docs/ARCHITECTURE.md §6 for the exact names each function reads.

# Analytics connectors (analytics-oauth, analytics-oauth-callback, analytics-sync)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_AD_ACCOUNT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URN=
LINKEDIN_AD_ACCOUNT_ID=
